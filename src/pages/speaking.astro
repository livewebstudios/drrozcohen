---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ArchFrame from '../components/ArchFrame.astro';
import LogoRow from '../components/LogoRow.astro';
import Threads from '../components/Threads.astro';
import CtaBand from '../components/CtaBand.astro';
import PreloadImage from '../components/PreloadImage.astro';
import { LOGOS } from '../data/site';
import { ogPath } from '../lib/og-path';
import { breadcrumbs, ID, abs } from '../lib/schema';
import { hero, trustedBy, keynotes, cta, meta } from '../data/pages/speaking';

import stage from '../assets/images/photos/rda_-_project_equity_-_fall_2023-98.jpg';

const schema = [
  {
    '@type': 'WebPage',
    '@id': abs('/speaking/#webpage'),
    url: abs('/speaking/'),
    name: meta.title,
    description: meta.description,
    isPartOf: { '@id': ID.website },
  },
  ...keynotes.map((k) => ({
    '@type': 'Service',
    '@id': abs(`/speaking/#${k.id}`),
    name: k.title,
    serviceType: 'Keynote',
    description: k.body[0],
    provider: { '@id': ID.org },
    areaServed: { '@type': 'Country', name: 'United States' },
    url: abs(`/speaking/#${k.id}`),
  })),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Speaking', path: '/speaking/' },
  ]),
];
---

<Base title={meta.title} description={meta.description} path="/speaking/" ogImage={ogPath('speaking')} schema={schema}>
  <PreloadImage slot="head" src={stage} widths={[400, 640, 720, 960, 1280]} sizes="(min-width: 1024px) 50vw, 92vw" quality={72} />
  <!-- 1. Hero -->
  <section class="shero" data-hero aria-labelledby="speaking-title">
    <Threads variant="light" seed={53} anchor={0.74} parallax={0.4} />
    <div class="container shero__grid">
      <div class="shero__text">
        <h1 id="speaking-title" class="fade-in">{hero.title}</h1>
        <div class="shero__intro">
          {hero.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="shero__media" data-parallax="0.85">
        <ArchFrame
          src={stage}
          alt="Dr. Roz Cohen on stage, pointing to the audience with notes in hand"
          shape="wide"
          sizes="(min-width: 1024px) 50vw, 92vw"
          widths={[400, 640, 720, 960, 1280]}
          focus="60 40"
          priority
        />
      </div>
    </div>
  </section>

  <!-- 2. Trusted By -->
  <Section flush>
    <div class="container trusted">
      <LogoRow label={trustedBy.label} logos={LOGOS.talks} id="trusted-by" />
    </div>
  </Section>

  <!-- 3. Keynotes -->
  <Section class="keynotes">
    <div class="container keynotes__grid">
      <nav class="knav" aria-labelledby="keynote-index-label" data-scrollspy>
        <p class="eyebrow knav__label" id="keynote-index-label">KEYNOTES</p>
        <ol class="knav__list" role="list">
          {
            keynotes.map((k) => (
              <li>
                <a class="knav__link" href={`#${k.id}`} data-spy-link>
                  <span class="knav__eyebrow">{k.eyebrow}</span>
                  <span class="knav__title">{k.title}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="keynotes__list">
        {
          keynotes.map((k) => (
            <article class="keynote" id={k.id} aria-labelledby={`${k.id}-title`} data-spy-target>
              <header class="keynote__head" data-reveal-group>
                <p class="eyebrow keynote__eyebrow" data-reveal>
                  {k.eyebrow}
                </p>
                <h2 id={`${k.id}-title`} class="keynote__title" data-reveal>
                  {k.title}
                </h2>
              </header>
              <div class="keynote__body">
                {k.body.map((p, i) =>
                  i === k.moment ? (
                    <p class="keynote__moment" data-reveal>
                      {p}
                    </p>
                  ) : (
                    <p data-reveal>{p}</p>
                  ),
                )}
                {k.note && <p class="keynote__note">{k.note}</p>}
              </div>
              <section class="objectives" aria-labelledby={`${k.id}-obj`}>
                <h3 class="objectives__title" id={`${k.id}-obj`}>
                  {k.objectivesLabel}
                </h3>
                <ol class="objectives__list" data-reveal-group>
                  {k.objectives.map((o) => (
                    <li data-reveal>{o}</li>
                  ))}
                </ol>
              </section>
            </article>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- 4. CTA -->
  <CtaBand text={cta.body} id="speaking-cta" seed={57} />
</Base>

<style>
  /* Hero */
  .shero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-top: calc(var(--header-h) + var(--s-7));
    padding-bottom: var(--s-9);
    background: linear-gradient(180deg, var(--paper) 0%, var(--blush) 100%);
  }
  .shero :global(.threads-bg) {
    z-index: -2;
  }
  .shero__grid {
    display: grid;
    gap: var(--s-7);
    align-items: center;
  }
  .shero h1 {
    max-width: 16ch;
    font-size: clamp(2.25rem, 1.4rem + 3.2vw, 4rem);
  }
  .shero__intro {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-6);
    max-width: 52ch;
    font-size: var(--fs-lg);
  }
  .shero__intro p:first-child {
    color: var(--ink);
  }
  @media (min-width: 1024px) {
    .shero {
      min-height: min(90svh, 880px);
      display: flex;
      align-items: center;
    }
    .shero__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-8);
    }
  }

  .trusted {
    padding-block: var(--s-7);
    border-bottom: 1px solid var(--line);
  }

  /* Keynotes */
  .keynotes__grid {
    display: grid;
    gap: var(--s-6);
  }
  .knav {
    position: sticky;
    top: calc(var(--header-h) - 1px);
    z-index: 5;
    margin-inline: calc(var(--gutter) * -1);
    padding: var(--s-3) var(--gutter);
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .knav__label {
    display: none;
  }
  .knav__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-2);
  }
  .knav__link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: var(--fs-xs);
    letter-spacing: var(--track-eyebrow);
    transition:
      background-color var(--d-fast) var(--ease-out),
      color var(--d-fast) var(--ease-out),
      border-color var(--d-fast) var(--ease-out);
  }
  .knav__title {
    display: none;
  }
  .knav__link[aria-current='true'] {
    background: var(--plum);
    border-color: var(--plum);
    color: var(--on-dark);
  }
  .keynote {
    padding-block: var(--s-8);
    scroll-margin-top: calc(var(--header-h) + var(--s-8));
  }
  .keynote + .keynote {
    border-top: 1px solid var(--line);
  }
  .keynote__head {
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-6);
  }
  .keynote__eyebrow {
    color: var(--plum);
  }
  .keynote__title {
    max-width: 22ch;
  }
  .keynote__body {
    display: grid;
    gap: var(--s-5);
    max-width: var(--measure);
    font-size: var(--fs-lg);
  }
  .keynote__moment {
    margin-block: var(--s-4);
    padding-left: var(--s-5);
    border-left: 2px solid var(--orchid);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.375rem);
    line-height: 1.2;
    letter-spacing: var(--track-snug);
    color: var(--plum);
  }
  .keynote__note {
    font-size: var(--fs-sm);
    font-style: italic;
    color: var(--slate);
  }
  .objectives {
    margin-top: var(--s-7);
    padding: clamp(var(--s-5), 4vw, var(--s-7));
    border-radius: var(--r-lg);
    background: var(--blush);
    max-width: var(--measure);
  }
  .objectives__title {
    font-size: var(--fs-xs);
    letter-spacing: var(--track-eyebrow);
    color: var(--slate);
    margin-bottom: var(--s-5);
  }
  .objectives__list {
    display: grid;
    gap: var(--s-4);
    padding: 0;
    list-style: none;
    counter-reset: obj;
  }
  .objectives__list li {
    position: relative;
    padding-left: var(--s-7);
    counter-increment: obj;
  }
  .objectives__list li::before {
    content: counter(obj, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.05em;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--fs-lg);
    line-height: 1.4;
    color: var(--plum);
  }
  @media (min-width: 1024px) {
    .keynotes__grid {
      grid-template-columns: 4fr 8fr;
      gap: var(--s-9);
      align-items: start;
    }
    .knav {
      top: calc(var(--header-h) + var(--s-7));
      margin: 0;
      padding: var(--s-8) 0 0;
      background: none;
      border: 0;
    }
    .knav__label {
      display: block;
      margin-bottom: var(--s-5);
    }
    .knav__list {
      grid-template-columns: 1fr;
      gap: 0;
      border-left: 1px solid var(--line);
    }
    .knav__link {
      display: grid;
      justify-content: start;
      gap: var(--s-2);
      padding: var(--s-5) var(--s-5);
      margin-left: -1px;
      border: 0;
      border-left: 2px solid transparent;
      border-radius: 0;
    }
    .knav__title {
      display: block;
      font-size: var(--fs-base);
      letter-spacing: var(--track-snug);
      line-height: 1.35;
    }
    .knav__link[aria-current='true'] {
      background: none;
      color: var(--plum);
      border-left-color: var(--plum);
    }
    .knav__link:hover {
      color: var(--plum);
    }
  }
</style>
