---
/** Dark plum CTA band at the end of a page: existing page sentence + GET IN TOUCH. */
import Threads from './Threads.astro';
import Button from './Button.astro';

export interface Props {
  text: string;
  id: string;
  seed?: number;
}
const { text, id, seed = 5 } = Astro.props;
---

<section class="cta-band on-dark" aria-labelledby={id}>
  <Threads variant="dark" seed={seed} density={0.6} />
  <div class="container cta-band__inner" data-reveal-group>
    <p class="cta-band__text" id={id} data-reveal>{text}</p>
    <div data-reveal>
      <Button href="/contact-us/" variant="light">GET IN TOUCH</Button>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: var(--band-y);
  }
  .cta-band :global(.threads-bg) {
    z-index: -1;
  }
  .cta-band__inner {
    display: grid;
    gap: var(--s-6);
    justify-items: start;
  }
  .cta-band__text {
    max-width: 30ch;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: 1.3;
    letter-spacing: var(--track-snug);
    color: var(--on-dark);
    text-wrap: balance;
  }
  @media (min-width: 1024px) {
    .cta-band__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: var(--s-8);
    }
    .cta-band__text {
      font-size: clamp(1.75rem, 1rem + 1.4vw, 2.375rem);
    }
  }
</style>
