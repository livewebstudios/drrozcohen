---
import { Image } from 'astro:assets';
import logo from '../assets/images/brand/logoRGB.png';
import MobileNav from '../islands/MobileNav';
import { NAV } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href) || (href === '/blog/' && /^\/(\d{4}|category)\//.test(path));
---

<header class="site-header" data-header>
  <div class="container site-header__bar">
    <a class="site-header__logo" href="/" aria-label="Dr. Roz Cohen, home">
      <Image src={logo} alt="Dr. Roz Cohen" width={176} layout="fixed" loading="eager" />
    </a>
    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list" role="list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="site-nav__link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <MobileNav client:idle items={NAV.map((n) => ({ ...n, current: isCurrent(n.href) }))} />
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    height: var(--header-h);
    display: flex;
    align-items: center;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      transform var(--d-med) var(--ease-out),
      background-color var(--d-med) var(--ease-out),
      border-color var(--d-med) var(--ease-out);
  }
  :global(.header-solid) .site-header,
  .site-header.is-solid {
    background: var(--paper);
    border-bottom-color: var(--line);
  }
  .site-header.is-hidden:not(:focus-within) {
    transform: translateY(-100%);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
  }
  .site-header__logo {
    display: block;
    flex: none;
    border-radius: var(--r-sm);
  }
  .site-header__logo :global(img) {
    width: clamp(118px, 9vw + 70px, 156px);
    height: auto;
  }
  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) clamp(var(--s-4), 2.2vw, var(--s-6));
  }
  .site-nav__link {
    position: relative;
    display: inline-block;
    padding-block: var(--s-2);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: var(--fs-xs);
    letter-spacing: var(--track-eyebrow);
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
  }
  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 2px;
    border-radius: 2px;
    background: var(--plum);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--d-fast) var(--ease-out);
  }
  .site-nav__link:hover {
    color: var(--plum);
  }
  .site-nav__link:hover::after,
  .site-nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .site-nav__link[aria-current='page'] {
    color: var(--plum);
  }

  /* Below 1024px: with JS the inline list hides and the MENU island takes over.
     Without JS the list stays visible and wraps under the logo. */
  @media (max-width: 1023px) {
    :global(.js) .site-nav {
      display: none;
    }
    :global(html:not(.js)) .site-header {
      position: relative;
      height: auto;
      padding-block: var(--s-3);
    }
    :global(html:not(.js)) .site-header__bar {
      flex-wrap: wrap;
    }
  }
</style>
