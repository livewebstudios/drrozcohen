# Copy to .env for local builds. Set the same keys in Netlify > Site configuration > Environment variables.
# GA4 measurement ID. Leave empty to skip the gtag snippet entirely.
PUBLIC_GA4_ID=
# Formspree form ID (the part after https://formspree.io/f/). Live form: https://formspree.io/f/mdearpoj
PUBLIC_FORMSPREE_ID=mdearpoj
